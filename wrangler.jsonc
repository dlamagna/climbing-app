{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "climbing-app",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	// Served at https://climbing-app.<your-subdomain>.workers.dev
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		// Only these hit the Worker; everything else is served as static files.
		// /.well-known goes to the Worker so OAuth discovery gets a 404 (the MCP server is token-in-URL,
		// no OAuth) instead of the SPA's index.html.
		"run_worker_first": [
			"/api/*",
			"/mcp",
			"/mcp/*",
			"/.well-known/*"
		]
	},
	// The values below are the upstream maintainer's. In your own copy: the Deploy to Cloudflare button replaces
	// database_id for you; on a manual deploy, replace it with the id `wrangler d1 create climbing` prints.
	// Point GITHUB_REPO at your own fork before you add the GITHUB_TOKEN secret; without that secret it does nothing.
	"vars": {
		// Repo the optional report_issue / list_issues MCP tools write to (needs the GITHUB_TOKEN secret).
		"GITHUB_REPO": "dlamagna/climbing-app",
		// Pinned roadmap issue: issues filed through report_issue are added to its checklist.
		"GITHUB_ROADMAP_ISSUE": "14"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "climbing",
			"database_id": "2292eea6-df4a-4522-b0a5-80fe46f3ab54",
			"migrations_dir": "migrations"
		}
	]
	// Secrets (set with `npx wrangler secret put <NAME>`, or .dev.vars locally):
	//   APP_TOKEN - the phone app sends this as a bearer token
	//   MCP_TOKEN - goes in the MCP URL you give to Claude
	//   GITHUB_TOKEN - optional; fine-grained token for GITHUB_REPO with Issues: read & write
	//   COACH_REVIEW_FIRE_URL / _TOKEN, ISSUE_WORKER_FIRE_URL / _TOKEN - optional; see README
	// .dev.vars.example lists the required ones.
}
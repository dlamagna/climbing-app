{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["."],
  // Tests run under Node via vitest (node:sqlite, node:fs), not in the Worker runtime.
  "exclude": ["**/*.test.ts"]
}
